# Compiled Python bytecode from sim/. Machine-specific, regenerated on
# every run, and a guaranteed source of pointless conflicts.
__pycache__/
*.py[cod]

# build/ is deliberately NOT ignored. It is generated by
# rules-toolset/tools/build.py, but the game server reads
# build/mechanics.json and build/snippets.json, so the compiled ruleset
# is tracked on purpose. Rebuild rather than hand-editing it.
